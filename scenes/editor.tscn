[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/editor.gd" id="1"]

[node name="EditorPage" type="PanelContainer" groups=["page"]]
theme_type_variation = &"Backdrop"
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 12

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TopBar" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Back" type="Button" parent="Margin/Column/TopBar"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
theme_type_variation = &"Link"
text = "‹ TAP MODE"

[node name="Title" type="Label" parent="Margin/Column/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Small"
text = "TITLE"
vertical_alignment = 1
clip_text = true
text_overrun_behavior = 3

[node name="Saved" type="Label" parent="Margin/Column/TopBar"]
layout_mode = 2
theme_type_variation = &"Dim"
vertical_alignment = 1

[node name="Reset" type="Button" parent="Margin/Column/TopBar"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
text = "RESET"

[node name="Run" type="Button" parent="Margin/Column/TopBar"]
custom_minimum_size = Vector2(160, 72)
layout_mode = 2
theme_type_variation = &"Primary"
text = "RUN"

[node name="Body" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="Code" type="CodeEdit" parent="Margin/Column/Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 3.0
scroll_smooth = true
gutters_draw_line_numbers = true
auto_brace_completion_enabled = true
auto_brace_completion_highlight_matching = true
indent_automatic = true

[node name="Side" type="ScrollContainer" parent="Margin/Column/Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 2.0
scroll_deadzone = 24
horizontal_scroll_mode = 0

[node name="SideColumn" type="VBoxContainer" parent="Margin/Column/Body/Side"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Prompt" type="Label" parent="Margin/Column/Body/Side/SideColumn"]
layout_mode = 2
theme_type_variation = &"Muted"
autowrap_mode = 3

[node name="Hints" type="VBoxContainer" parent="Margin/Column/Body/Side/SideColumn"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Docs" type="VBoxContainer" parent="Margin/Column/Body/Side/SideColumn"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="SolutionToggle" type="Button" parent="Margin/Column/Body/Side/SideColumn"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
mouse_filter = 1
theme_type_variation = &"Link"
text = "[#] REFERENCE SOLUTION"
alignment = 0
clip_text = true
text_overrun_behavior = 3

[node name="Solution" type="Label" parent="Margin/Column/Body/Side/SideColumn"]
visible = false
layout_mode = 2
theme_type_variation = &"Code"
autowrap_mode = 3

[node name="Keys" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 6
