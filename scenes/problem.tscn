[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/problem.gd" id="1"]

[node name="ProblemPage" type="PanelContainer" groups=["page"]]
theme_type_variation = &"Backdrop"
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 0

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TopBar" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2

[node name="Back" type="Button" parent="Margin/Column/TopBar"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
theme_type_variation = &"Link"
text = "‹ BACK"

[node name="Meta" type="Label" parent="Margin/Column/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Small"
text = "TOPIC · 01"
horizontal_alignment = 2
clip_text = true
text_overrun_behavior = 3

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
scroll_deadzone = 24
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Margin/Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Margin/Column/Scroll/Body"]
layout_mode = 2
theme_type_variation = &"Heading2"
text = "TITLE"
autowrap_mode = 3

[node name="Status" type="Label" parent="Margin/Column/Scroll/Body"]
layout_mode = 2
theme_type_variation = &"Accent"
autowrap_mode = 3

[node name="Prompt" type="Label" parent="Margin/Column/Scroll/Body"]
layout_mode = 2
text = "Prompt"
autowrap_mode = 3

[node name="ModeBar" type="HBoxContainer" parent="Margin/Column/Scroll/Body"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="ModeHost" type="VBoxContainer" parent="Margin/Column/Scroll/Body"]
layout_mode = 2

[node name="Preparing" type="Label" parent="Margin/Column/Scroll/Body"]
visible = false
layout_mode = 2
theme_type_variation = &"Muted"
text = "Preparing…"

[node name="Actions" type="HBoxContainer" parent="Margin/Column/Scroll/Body"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Run" type="Button" parent="Margin/Column/Scroll/Body/Actions"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 1
theme_type_variation = &"Primary"
text = "RUN"

[node name="Reset" type="Button" parent="Margin/Column/Scroll/Body/Actions"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
mouse_filter = 1
text = "RESET"

[node name="Results" type="VBoxContainer" parent="Margin/Column/Scroll/Body"]
visible = false
layout_mode = 2
theme_override_constants/separation = 12

[node name="Verdict" type="Label" parent="Margin/Column/Scroll/Body/Results"]
layout_mode = 2
theme_type_variation = &"Heading3"
autowrap_mode = 3

[node name="Count" type="Label" parent="Margin/Column/Scroll/Body/Results"]
layout_mode = 2
theme_type_variation = &"Small"

[node name="VerdictNote" type="Label" parent="Margin/Column/Scroll/Body/Results"]
layout_mode = 2
theme_type_variation = &"Muted"
autowrap_mode = 3

[node name="Tests" type="VBoxContainer" parent="Margin/Column/Scroll/Body/Results"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="OutputLabel" type="Label" parent="Margin/Column/Scroll/Body/Results"]
layout_mode = 2
theme_type_variation = &"Small"
text = "OUTPUT"

[node name="Output" type="Label" parent="Margin/Column/Scroll/Body/Results"]
layout_mode = 2
theme_type_variation = &"Code"
autowrap_mode = 3

[node name="ErrorsLabel" type="Label" parent="Margin/Column/Scroll/Body/Results"]
layout_mode = 2
theme_type_variation = &"Small"
text = "ERRORS"

[node name="Errors" type="Label" parent="Margin/Column/Scroll/Body/Results"]
layout_mode = 2
theme_type_variation = &"Error"
autowrap_mode = 3

[node name="NoteLabel" type="Label" parent="Margin/Column/Scroll/Body"]
layout_mode = 2
theme_type_variation = &"Small"
text = "NOTES · WHAT I DON'T GET"

[node name="Note" type="TextEdit" parent="Margin/Column/Scroll/Body"]
custom_minimum_size = Vector2(0, 240)
layout_mode = 2
placeholder_text = "What I don't get, or what I missed."
wrap_mode = 1
scroll_fit_content_height = true

[node name="NoteRow" type="HBoxContainer" parent="Margin/Column/Scroll/Body"]
layout_mode = 2

[node name="Resolved" type="Button" parent="Margin/Column/Scroll/Body/NoteRow"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
mouse_filter = 1
theme_type_variation = &"Link"
toggle_mode = true
text = "[ ] RESOLVED"

[node name="Saved" type="Label" parent="Margin/Column/Scroll/Body/NoteRow"]
layout_mode = 2
size_flags_horizontal = 10
theme_type_variation = &"Dim"

[node name="Bottom" type="Control" parent="Margin/Column/Scroll/Body"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
