vertical_alignment = 1

[node name="CloseNote" type="Button" parent="Column/NotesDrawer/NotesColumn/NoteRow"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
theme_type_variation = &"Link"
text = "DONE"

[node name="Bar" type="PanelContainer" parent="Column"]
layout_mode = 2
