[gd_scene load_steps=3 format=3]

[ext_resource type="PackedScene" path="res://scenes/screens/screen_header.tscn" id="1"]
[ext_resource type="Script" path="res://scenes/screens/profile.gd" id="2"]

[node name="Profile" type="MarginContainer"]
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 0
script = ExtResource("2")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
scroll_deadzone = 24
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 28

[node name="Header" parent="Scroll/Body" instance=ExtResource("1")]
layout_mode = 2
eyebrow = "Account"
title = "Profile"

[node name="Account" type="PanelContainer" parent="Scroll/Body"]
layout_mode = 2

[node name="Column" type="VBoxContainer" parent="Scroll/Body/Account"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Label" type="Label" parent="Scroll/Body/Account/Column"]
layout_mode = 2
theme_type_variation = &"Small"
text = "SIGNED IN AS"

[node name="Name" type="Label" parent="Scroll/Body/Account/Column"]
layout_mode = 2
theme_type_variation = &"Heading2"
text = "—"
autowrap_mode = 3

[node name="Email" type="Label" parent="Scroll/Body/Account/Column"]
layout_mode = 2
theme_type_variation = &"Muted"
autowrap_mode = 3

[node name="Streak" type="PanelContainer" parent="Scroll/Body"]
layout_mode = 2
theme_type_variation = &"PanelActive"

[node name="Column" type="VBoxContainer" parent="Scroll/Body/Streak"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Label" type="Label" parent="Scroll/Body/Streak/Column"]
layout_mode = 2
theme_type_variation = &"Small"
text = "DAY STREAK"

[node name="Value" type="Label" parent="Scroll/Body/Streak/Column"]
layout_mode = 2
theme_type_variation = &"Big"
text = "…"

[node name="Note" type="Label" parent="Scroll/Body/Streak/Column"]
layout_mode = 2
theme_type_variation = &"Muted"
autowrap_mode = 3

[node name="Settings" type="PanelContainer" parent="Scroll/Body"]
layout_mode = 2

[node name="Column" type="VBoxContainer" parent="Scroll/Body/Settings"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Label" type="Label" parent="Scroll/Body/Settings/Column"]
layout_mode = 2
theme_type_variation = &"Small"
text = "SETTINGS"

[node name="SetSize" type="HBoxContainer" parent="Scroll/Body/Settings/Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="SetSizeColumn" type="VBoxContainer" parent="Scroll/Body/Settings/Column/SetSize"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="SetSizeLabel" type="Label" parent="Scroll/Body/Settings/Column/SetSize/SetSizeColumn"]
layout_mode = 2
text = "New problems a day"

[node name="SetSizeValue" type="Label" parent="Scroll/Body/Settings/Column/SetSize/SetSizeColumn"]
layout_mode = 2
theme_type_variation = &"Heading3"
text = "5"

[node name="SetSizeNote" type="Label" parent="Scroll/Body/Settings/Column/SetSize/SetSizeColumn"]
layout_mode = 2
theme_type_variation = &"Detail"
text = "The site uses 5. Another number here changes the phone's set."
autowrap_mode = 3

[node name="SizeLess" type="Button" parent="Scroll/Body/Settings/Column/SetSize"]
custom_minimum_size = Vector2(88, 88)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 1
text = "−"

[node name="SizeMore" type="Button" parent="Scroll/Body/Settings/Column/SetSize"]
