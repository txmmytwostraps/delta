[gd_scene load_steps=3 format=3]

[ext_resource type="PackedScene" path="res://scenes/screens/screen_header.tscn" id="1"]
[ext_resource type="Script" path="res://scenes/screens/profile.gd" id="2"]

[node name="Profile" type="MarginContainer"]
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 0
script = ExtResource("2")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 28

[node name="Header" parent="Scroll/Body" instance=ExtResource("1")]
layout_mode = 2
eyebrow = "Account"
title = "Profile"

[node name="Account" type="PanelContainer" parent="Scroll/Body"]
layout_mode = 2

[node name="Column" type="VBoxContainer" parent="Scroll/Body/Account"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Label" type="Label" parent="Scroll/Body/Account/Column"]
layout_mode = 2
theme_type_variation = &"Small"
text = "SIGNED IN AS"

[node name="Name" type="Label" parent="Scroll/Body/Account/Column"]
layout_mode = 2
theme_type_variation = &"Heading2"
text = "—"
autowrap_mode = 3

[node name="Email" type="Label" parent="Scroll/Body/Account/Column"]
layout_mode = 2
theme_type_variation = &"Muted"
autowrap_mode = 3

[node name="Streak" type="PanelContainer" parent="Scroll/Body"]
layout_mode = 2
theme_type_variation = &"PanelActive"

[node name="Column" type="VBoxContainer" parent="Scroll/Body/Streak"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Label" type="Label" parent="Scroll/Body/Streak/Column"]
layout_mode = 2
theme_type_variation = &"Small"
text = "DAY STREAK"

[node name="Value" type="Label" parent="Scroll/Body/Streak/Column"]
layout_mode = 2
theme_type_variation = &"Big"
text = "…"

[node name="Note" type="Label" parent="Scroll/Body/Streak/Column"]
layout_mode = 2
theme_type_variation = &"Muted"
autowrap_mode = 3

[node name="Sync" type="PanelContainer" parent="Scroll/Body"]
layout_mode = 2

[node name="Column" type="VBoxContainer" parent="Scroll/Body/Sync"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Label" type="Label" parent="Scroll/Body/Sync/Column"]
layout_mode = 2
theme_type_variation = &"Small"
text = "ACCOUNT SYNC"

[node name="Status" type="Label" parent="Scroll/Body/Sync/Column"]
layout_mode = 2
theme_type_variation = &"Muted"
text = "…"
autowrap_mode = 3

[node name="SyncNow" type="Button" parent="Scroll/Body/Sync/Column"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
text = "SYNC NOW"

[node name="SignOut" type="Button" parent="Scroll/Body"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
text = "SIGN OUT"

[node name="Version" type="Label" parent="Scroll/Body"]
layout_mode = 2
theme_type_variation = &"Dim"
text = "Delta"
