[gd_scene format=3]

[node name="Page" type="PanelContainer" groups=["page"]]
theme_type_variation = &"Backdrop"

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TopBand" type="PanelContainer" parent="Column"]
layout_mode = 2
theme_type_variation = &"TopBar"

[node name="TopMargin" type="MarginContainer" parent="Column/TopBand"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 8

[node name="TopBar" type="HBoxContainer" parent="Column/TopBand/TopMargin"]
layout_mode = 2

[node name="Back" type="Button" parent="Column/TopBand/TopMargin/TopBar"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
theme_type_variation = &"Link"
text = "‹ BACK"

[node name="Meta" type="Label" parent="Column/TopBand/TopMargin/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Small"
text = ""
horizontal_alignment = 2
vertical_alignment = 1
clip_text = true
text_overrun_behavior = 3

[node name="Scroll" type="ScrollContainer" parent="Column"]
layout_mode = 2
size_flags_vertical = 3
scroll_deadzone = 24
horizontal_scroll_mode = 0

[node name="Margin" type="MarginContainer" parent="Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 48

[node name="Body" type="VBoxContainer" parent="Column/Scroll/Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Bar" type="PanelContainer" parent="Column"]
visible = false
layout_mode = 2
theme_type_variation = &"BottomBar"

[node name="BarMargin" type="MarginContainer" parent="Column/Bar"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 16

[node name="Go" type="Button" parent="Column/Bar/BarMargin"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
theme_type_variation = &"Primary"
text = "GO"
clip_text = true
text_overrun_behavior = 3
