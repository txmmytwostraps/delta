[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/week.gd" id="1"]

[node name="WeekPage" type="PanelContainer" groups=["page"]]
theme_type_variation = &"Backdrop"
script = ExtResource("1")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TopMargin" type="MarginContainer" parent="Column"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 8

[node name="TopBar" type="HBoxContainer" parent="Column/TopMargin"]
layout_mode = 2

[node name="Back" type="Button" parent="Column/TopMargin/TopBar"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
theme_type_variation = &"Link"
text = "‹ BACK"

[node name="Meta" type="Label" parent="Column/TopMargin/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Small"
text = "STATS · THIS WEEK"
horizontal_alignment = 2
vertical_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Column"]
layout_mode = 2
size_flags_vertical = 3
scroll_deadzone = 24
horizontal_scroll_mode = 0

[node name="Margin" type="MarginContainer" parent="Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 48

[node name="Body" type="VBoxContainer" parent="Column/Scroll/Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Column/Scroll/Margin/Body"]
layout_mode = 2
theme_type_variation = &"Heading"
text = "THIS WEEK"

[node name="Intro" type="Label" parent="Column/Scroll/Margin/Body"]
layout_mode = 2
theme_type_variation = &"Muted"
text = "The last seven days as plain text: what you did per topic, reviews, notes, what is due next, and the changes the numbers suggest. Copy it for your weekly review; the settings it points at live on the Route."
autowrap_mode = 3

[node name="SummaryPanel" type="PanelContainer" parent="Column/Scroll/Margin/Body"]
layout_mode = 2

[node name="Summary" type="Label" parent="Column/Scroll/Margin/Body/SummaryPanel"]
layout_mode = 2
theme_type_variation = &"DetailCode"
text = "Loading…"
autowrap_mode = 3

[node name="Bar" type="PanelContainer" parent="Column"]
layout_mode = 2
theme_type_variation = &"BottomBar"

[node name="BarMargin" type="MarginContainer" parent="Column/Bar"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 16

[node name="Actions" type="HBoxContainer" parent="Column/Bar/BarMargin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Copy" type="Button" parent="Column/Bar/BarMargin/Actions"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Primary"
text = "COPY THE SUMMARY"

[node name="Copied" type="Label" parent="Column/Bar/BarMargin/Actions"]
layout_mode = 2
theme_type_variation = &"Dim"
vertical_alignment = 1
