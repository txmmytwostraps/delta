[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/judge_check.gd" id="1"]

[node name="JudgeCheck" type="PanelContainer" groups=["page"]]
theme_type_variation = &"Backdrop"
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 0

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TopBar" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2

[node name="Back" type="Button" parent="Margin/Column/TopBar"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
theme_type_variation = &"Link"
text = "‹ BACK"

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
scroll_deadzone = 24
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Margin/Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 20

[node name="Eyebrow" type="Label" parent="Margin/Column/Scroll/Body"]
layout_mode = 2
theme_type_variation = &"Eyebrow"
text = "THE JUDGE"

[node name="Title" type="Label" parent="Margin/Column/Scroll/Body"]
layout_mode = 2
theme_type_variation = &"Heading"
text = "CHECK"

[node name="Intro" type="Label" parent="Margin/Column/Scroll/Body"]
layout_mode = 2
theme_type_variation = &"Muted"
text = "Runs the site's own test cases through the judge on this phone. The first three must give exactly the site's results; the rest show how runaway code is handled."
autowrap_mode = 3

[node name="Run" type="Button" parent="Margin/Column/Scroll/Body"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
mouse_filter = 1
theme_type_variation = &"Primary"
text = "RUN THE CHECK"

[node name="Summary" type="Label" parent="Margin/Column/Scroll/Body"]
layout_mode = 2
theme_type_variation = &"Heading3"
autowrap_mode = 3

[node name="Cases" type="VBoxContainer" parent="Margin/Column/Scroll/Body"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Bottom" type="Control" parent="Margin/Column/Scroll/Body"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
