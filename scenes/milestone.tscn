[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/milestone.gd" id="1"]

[node name="MilestonePage" type="PanelContainer" groups=["page"]]
theme_type_variation = &"Backdrop"
script = ExtResource("1")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TopMargin" type="MarginContainer" parent="Column"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 8

[node name="TopBar" type="HBoxContainer" parent="Column/TopMargin"]
layout_mode = 2

[node name="Back" type="Button" parent="Column/TopMargin/TopBar"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
theme_type_variation = &"Link"
text = "‹ ROUTE"

[node name="Meta" type="Label" parent="Column/TopMargin/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Small"
text = "MILESTONE"
horizontal_alignment = 2
vertical_alignment = 1
clip_text = true
text_overrun_behavior = 3

[node name="Scroll" type="ScrollContainer" parent="Column"]
layout_mode = 2
size_flags_vertical = 3
scroll_deadzone = 24
horizontal_scroll_mode = 0

[node name="Margin" type="MarginContainer" parent="Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 48

[node name="Body" type="VBoxContainer" parent="Column/Scroll/Margin"]
layout_mode = 2
theme_override_constants/separation = 48

[node name="Steps" type="HBoxContainer" parent="Column/Scroll/Margin/Body"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Banner" type="Label" parent="Column/Scroll/Margin/Body"]
visible = false
layout_mode = 2
theme_type_variation = &"Amber"
autowrap_mode = 3

[node name="Lock" type="Label" parent="Column/Scroll/Margin/Body"]
visible = false
layout_mode = 2
theme_type_variation = &"Muted"
autowrap_mode = 3

[node name="StageHost" type="VBoxContainer" parent="Column/Scroll/Margin/Body"]
layout_mode = 2

[node name="Head" type="VBoxContainer" parent="Column/Scroll/Margin/Body"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Column/Scroll/Margin/Body/Head"]
layout_mode = 2
theme_type_variation = &"Heading2"
text = "STEP"
clip_text = true
text_overrun_behavior = 3

[node name="Prompt" type="Label" parent="Column/Scroll/Margin/Body/Head"]
layout_mode = 2
autowrap_mode = 3

[node name="Modes" type="HBoxContainer" parent="Column/Scroll/Margin/Body"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Work" type="VBoxContainer" parent="Column/Scroll/Margin/Body"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="InstructionColumn" type="VBoxContainer" parent="Column/Scroll/Margin/Body/Work"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="InstructionText" type="Label" parent="Column/Scroll/Margin/Body/Work/InstructionColumn"]
layout_mode = 2
theme_type_variation = &"Detail"
autowrap_mode = 3

[node name="ModeHost" type="VBoxContainer" parent="Column/Scroll/Margin/Body/Work"]
layout_mode = 2

[node name="Checks" type="VBoxContainer" parent="Column/Scroll/Margin/Body"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Hints" type="VBoxContainer" parent="Column/Scroll/Margin/Body"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Docs" type="VBoxContainer" parent="Column/Scroll/Margin/Body"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Godot" type="VBoxContainer" parent="Column/Scroll/Margin/Body"]
visible = false
layout_mode = 2
theme_override_constants/separation = 16

[node name="Bar" type="PanelContainer" parent="Column"]
layout_mode = 2
theme_type_variation = &"BottomBar"

[node name="BarMargin" type="MarginContainer" parent="Column/Bar"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 16

[node name="Actions" type="HBoxContainer" parent="Column/Bar/BarMargin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Run" type="Button" parent="Column/Bar/BarMargin/Actions"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Primary"
text = "RUN THE CHECKS"

[node name="Reset" type="Button" parent="Column/Bar/BarMargin/Actions"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
text = "RESET"

[node name="Next" type="Button" parent="Column/Bar/BarMargin/Actions"]
visible = false
